// ============================================================
// conf/base.config — resource requirements per process label
// Labels are declared inside each module with: label 'mem_32g'
// ============================================================

process {

    withLabel: cpu_4 {
        cpus = 4
    }

    withLabel: cpu_8 {
        cpus = 8
    }

    withLabel: mem_32g {
        memory = '32 GB'
    }

    withLabel: mem_64g {
        memory = '64 GB'
    }

    withLabel: time_24h {
        time = '24h'
    }

    withLabel: time_48h {
        time = '48h'
    }

    withLabel: time_72h {
        time = '72h'
    }
}
