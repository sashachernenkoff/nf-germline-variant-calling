// ============================================================
// conf/aws.config - AWS Batch execution profile
//
// Resources provisioned:
//   S3 bucket:           nf-germline-sic (us-east-1)
//   Batch compute env:   nf-germline-ondemand (EC2 on-demand, r5/m5, max 64 vCPUs)
//   Batch job queue:     nf-germline-ondemand-queue
//   Batch job IAM role:  BatchJobRole-nf-germline
//
//   Note: spot instance queue (nf-germline-queue) left in place for future use
//   once spot quota is approved. New accounts default to 0 spot capacity.
// ============================================================

params {
    aws_region = 'us-east-1'
}

aws {
    region = params.aws_region

    batch {
        // cliPath = '/usr/local/bin/aws'
        jobRole = 'arn:aws:iam::369904859266:role/BatchJobRole-nf-germline'
    }

    client {
        maxConnections  = 20
        connectionTimeout = 60000
    }
}

process {
    // All processes run on AWS Batch.
    // Nextflow submits each process as a Batch job automatically.
    queue = 'nf-germline-queue-r5'

    // Resource overrides for AWS instance sizing.
    // r5 (memory optimised) - good for GATK Java heap
    // c5 (compute optimised) - good for mosdepth, bcftools
    withLabel: mem_16g {
        memory = '14 GB'
        cpus   = 4
    }
    withLabel: mem_32g {
        memory = '14 GB'
        cpus   = 4
    }
    withLabel: mem_64g {
        memory = '14 GB'
        cpus   = 4
    }
}

// Nextflow writes its work directory to S3 when running on Batch.
// Example run command:
//
//   nextflow run main.nf -profile aws \
//     -w s3://nf-germline-sic/work \
//     --input   s3://nf-germline-sic/inputs/sample_sheet.tsv \
//     --ref     s3://nf-germline-sic/ref/GRCh38.fa \
//     --outdir  s3://nf-germline-sic/results \
//     --dbsnp   s3://nf-germline-sic/known-sites/dbsnp138.vcf.gz \
//     --mills   s3://nf-germline-sic/known-sites/mills.vcf.gz \
//     --onekg   s3://nf-germline-sic/known-sites/1000G_phase1.snps.hg38.vcf.gz \
//     --intervals_dir s3://nf-germline-sic/intervals/
