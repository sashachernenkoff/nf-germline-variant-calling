// ============================================================
// conf/aws.config - AWS Batch execution profile
//
// Deployment-specific values are read from environment variables so this
// config stays account-agnostic. Set these before running -profile aws:
//   NF_ECR_REGISTRY    ECR registry hosting the pipeline images, e.g.
//                      123456789012.dkr.ecr.us-east-1.amazonaws.com
//   NF_BATCH_QUEUE     AWS Batch job queue name
//   NF_BATCH_JOB_ROLE  ARN of the Batch job role
//   AWS_REGION         AWS region (default: us-east-1)
// Each can also be overridden on the command line, e.g. --batch_queue my-queue
// ============================================================

params {
    aws_region     = System.getenv('AWS_REGION') ?: 'us-east-1'
    batch_queue    = System.getenv('NF_BATCH_QUEUE')
    batch_job_role = System.getenv('NF_BATCH_JOB_ROLE')
    ecr_registry   = System.getenv('NF_ECR_REGISTRY')

    // Pipeline images (AWS CLI baked in, built from docker/).
    gatk_container     = System.getenv('NF_ECR_REGISTRY') ? "${System.getenv('NF_ECR_REGISTRY')}/nf-germline-gatk:4.5.0.0-aws"   : null
    mosdepth_container = System.getenv('NF_ECR_REGISTRY') ? "${System.getenv('NF_ECR_REGISTRY')}/nf-germline-mosdepth:0.3.8-aws" : null
    bcftools_container = System.getenv('NF_ECR_REGISTRY') ? "${System.getenv('NF_ECR_REGISTRY')}/nf-germline-bcftools:1.18-aws"  : null
}

aws {
    region = params.aws_region

    batch {
        // No cliPath: the images provide `aws` on PATH. Setting it would make
        // Nextflow mount the host's /usr/local over the container.
        jobRole = params.batch_job_role
    }

    client {
        maxConnections    = 20
        connectionTimeout = 60000
    }
}

process {
    queue = params.batch_queue

    // Cap requests to the largest instance type in the compute environment.
    withLabel: mem_16g {
        memory = '14 GB'
        cpus   = 4
    }
    withLabel: mem_32g {
        memory = '14 GB'
        cpus   = 4
    }
    withLabel: mem_64g {
        memory = '14 GB'
        cpus   = 4
    }
}
