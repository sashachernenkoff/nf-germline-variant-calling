// ============================================================
// conf/aws.config - AWS Batch execution profile
// ============================================================

params {
    aws_region = 'us-east-1'

    // ECR images with the AWS CLI added for S3 staging (built from docker/).
    gatk_container     = '369904859266.dkr.ecr.us-east-1.amazonaws.com/nf-germline-gatk:4.5.0.0-aws'
    mosdepth_container = '369904859266.dkr.ecr.us-east-1.amazonaws.com/nf-germline-mosdepth:0.3.8-aws'
    bcftools_container = '369904859266.dkr.ecr.us-east-1.amazonaws.com/nf-germline-bcftools:1.18-aws'
}

aws {
    region = params.aws_region

    batch {
        // No cliPath: the images provide `aws` on PATH. Setting it would make
        // Nextflow mount the host's /usr/local over the container.
        jobRole = 'arn:aws:iam::369904859266:role/BatchJobRole-nf-germline'
    }

    client {
        maxConnections    = 20
        connectionTimeout = 60000
    }
}

process {
    queue = 'nf-germline-queue-r5'

    // Cap requests to the largest instance type in the compute environment.
    withLabel: mem_16g {
        memory = '14 GB'
        cpus   = 4
    }
    withLabel: mem_32g {
        memory = '14 GB'
        cpus   = 4
    }
    withLabel: mem_64g {
        memory = '14 GB'
        cpus   = 4
    }
}
