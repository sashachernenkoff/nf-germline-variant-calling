// ============================================================
// conf/aws.config - AWS Batch execution profile
//
// Prerequisites (created once in the AWS console or CLI):
//   1. S3 bucket for pipeline data and results
//   2. Batch compute environment (EC2, spot instances recommended)
//   3. Batch job queue pointing at that compute environment
//   4. IAM role for Batch jobs with S3 read/write permissions
//
// Fill in the placeholders below before running with -profile aws.
// ============================================================

params {
    // S3 bucket used for all input data, reference files, and results.
    // Override per-run with: --outdir s3://your-bucket/run-name/
    aws_region = 'us-east-1'
}

aws {
    region = params.aws_region

    batch {
        // The Batch job queue to submit jobs to.
        // Created in the AWS console under Batch > Job queues.
        cliPath   = '/usr/local/bin/aws'
        jobRole   = 'arn:aws:iam::YOUR_ACCOUNT_ID:role/YOUR_BATCH_JOB_ROLE'
    }

    client {
        maxConnections  = 20
        connectionTimeout = 60000
    }
}

process {
    // All processes run on AWS Batch.
    // Nextflow submits each process as a Batch job automatically.
    queue = 'YOUR_BATCH_JOB_QUEUE_NAME'

    // Use spot instances by default - up to 90% cheaper than on-demand.
    // Nextflow retries automatically if a spot instance is reclaimed.
    // Override for a specific process with: process.spot = false
    // Note: set via Batch compute environment configuration, not here.

    // Resource overrides for AWS instance sizing.
    // These replace the base.config values when running on AWS.
    // EC2 instance families:
    //   r5 (memory optimised) - good for GATK Java heap
    //   c5 (compute optimised) - good for mosdepth, bcftools
    withLabel: mem_16g {
        memory = '16 GB'
        cpus   = 4
    }
    withLabel: mem_32g {
        memory = '32 GB'
        cpus   = 8
    }
    withLabel: mem_64g {
        memory = '64 GB'
        cpus   = 8
    }
}

// Nextflow writes its work directory to S3 when running on Batch.
// Set workDir on the command line:
//   nextflow run main.nf -profile aws -w s3://your-bucket/work/ ...
// The work directory holds intermediate files; only publishDir outputs
// are copied to your --outdir.
