// ============================================================
// nf-germline-variant-calling - nextflow.config
// All pipeline inputs are declared here as params with defaults.
// Override any param on the command line: --ref /path/to/ref.fa
// ============================================================

params {

    // --- Required inputs ---
    input        = null          // path to sample sheet TSV (columns: sample_id, bam)
    ref          = null          // path/URI to reference FASTA (must have .fai + .dict)
    outdir       = "results"

    // --- GATK known-sites bundles ---
    dbsnp        = null          // Homo_sapiens_assembly38.dbsnp138.vcf.gz
    mills        = null          // Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
    onekg        = null          // 1000G_phase1.snps.high_confidence.hg38.vcf.gz
    hapmap       = null          // hapmap_3.3.hg38.vcf.gz  (VQSR only)
    omni         = null          // 1000G_omni2.5.hg38.vcf.gz  (VQSR only)

    // --- Scatter intervals ---
    // Path to a directory of .interval_list files (one per shard).
    // Generate with: gatk SplitIntervals -R ref.fa -scatter 100 -O intervals/
    intervals_dir = null

    // --- Coverage QC ---
    // Samples whose mean coverage over the calling regions is below this
    // threshold are excluded before HaplotypeCaller.
    min_coverage = 10

    // --- Variant filtering strategy ---
    // false (default): hard filtering - works for any cohort size
    // true:            AS-VQSR - requires a large cohort (30+ samples for SNPs)
    vqsr         = false

    // --- Resource tuning ---
    // Optical duplicate pixel distance:
    //   2500 for patterned flowcells (NovaSeq, HiSeq 4000)
    //   100  for unpatterned flowcells (HiSeq 2500 and older)
    optical_dup_pixel_dist = 2500

    // --- Container images ---
    // Public images are the defaults (used by the local profile). The aws
    // profile overrides these in conf/aws.config with ECR copies that have
    // the AWS CLI baked in, which AWS Batch needs for S3 staging.
    gatk_container     = 'broadinstitute/gatk:4.5.0.0'
    mosdepth_container = 'quay.io/biocontainers/mosdepth:0.3.8--hd299d5a_0'
    bcftools_container = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'
}

// ============================================================
// Profiles - switch with: nextflow run main.nf -profile aws
// ============================================================

profiles {

    local {
        process.executor = 'local'
        includeConfig 'conf/base.config'
    }

    aws {
        process.executor        = 'awsbatch'
        includeConfig 'conf/base.config'
        includeConfig 'conf/aws.config'
    }
}

// ============================================================
// Docker
// ============================================================

docker {
    enabled    = true
    runOptions = '--platform linux/amd64'  // run amd64 images on arm64 hosts
}

// ============================================================
// Default process settings
// ============================================================

process {
    errorStrategy = 'retry'
    maxRetries    = 1
}
